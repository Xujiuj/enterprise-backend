# Enterprise backend standalone delivery defaults.
REGISTRY=local
IMAGE_NAMESPACE=fx
IMAGE_TAG=latest

ENTERPRISE_DB_URL=jdbc:sqlserver://127.0.0.1:1433;DatabaseName=enterprise;encrypt=false;trustServerCertificate=true;SelectMethod=cursor
ENTERPRISE_DB_USERNAME=sa
ENTERPRISE_DB_PASSWORD=

FX_SQLSERVER_HOST=127.0.0.1,1433
FX_SQLSERVER_USER=sa
FX_SQLSERVER_PASSWORD=
FX_ENTERPRISE_DATABASE=enterprise

ENTERPRISE_REDIS_HOST=enterprise-redis
ENTERPRISE_REDIS_PORT=6379
ENTERPRISE_REDIS_PASSWORD=

ENTERPRISE_BACKEND_PORT=18001
ENTERPRISE_SNAIL_PORT=28081
ENTERPRISE_VENDOR_OPEN_BASE_URL=http://vendor-backend:8080
ENTERPRISE_BACKEND_JAVA_OPTS=

FX_DOCKER_NETWORK=fx-delivery
